# ─── App ─────────────────────────────────────────────────────────────
# En Vercel puede omitirse: se usa el dominio de producción o el de la rama.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (PostgreSQL + Auth + Storage) ──────────────────────────
# Local: se muestran al ejecutar `npm run db:start`
# Nube:  Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Pagos: culqi | izipay | niubiz ──────────────────────────────────
PAYMENT_PROVIDER=culqi
# Llaves de CulqiPanel (pk_test_… / sk_test_… en integración). Sin ellas el pago en línea sale como «Próximamente».
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Clave larga y aleatoria. En CulqiPanel → Eventos → Webhooks, la URL es
#   https://<dominio>/api/pagos/webhook/culqi?clave=<CULQI_WEBHOOK_SECRET>
# con los eventos order.status.changed y charge.creation.succeeded. Sin clave, los webhooks se rechazan
# y el pago en línea no se activa.
CULQI_WEBHOOK_SECRET=
# Activar después de configurar el celular (9 dígitos) y el titular de la cuenta Yape / Plin de PEDSAR E.I.R.L.
PAGO_MANUAL_HABILITADO=false
NEXT_PUBLIC_PAGO_DIRECTO_CELULAR=
NEXT_PUBLIC_PAGO_DIRECTO_TITULAR=
IZIPAY_MERCHANT_CODE=
IZIPAY_API_KEY=
NIUBIZ_MERCHANT_ID=
NIUBIZ_USER=
NIUBIZ_PASSWORD=

# ─── Datos operativos de contacto (PEDSAR E.I.R.L.) ──────────────────
NEXT_PUBLIC_EMPRESA_TELEFONO="+51 956 000 000"
NEXT_PUBLIC_EMPRESA_WHATSAPP=51956000000
NEXT_PUBLIC_EMPRESA_CORREO=informes@pedsar.pe
NEXT_PUBLIC_EMPRESA_HORARIO="Lunes a viernes de 9:00 a 18:00 · Sábados de 9:00 a 13:00"

# ─── Correo (Resend) ─────────────────────────────────────────────────
# Sin API key, los correos se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM="PEDSAR <no-reply@pedsar.pe>"

# ─── Analítica y monitoreo ───────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SENTRY_DSN=
